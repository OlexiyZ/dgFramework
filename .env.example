# Copy to .env and fill in real values. Never commit .env.
#
# Generate a new secret key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# --- Runtime -----------------------------------------------------------------
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1
TZ=Asia/Amman

# --- Django ------------------------------------------------------------------
# Required. The application refuses to start without it.
DJANGO_SECRET_KEY=

# Never enable outside local development.
DEBUG=False

# Comma-separated hostnames, e.g. reports-govern.baelab.net,localhost
ALLOWED_HOSTS=localhost,127.0.0.1

# Public base URL, used for CORS and CSRF trusted origins.
HOST=http://localhost:8000

# --- Database ----------------------------------------------------------------
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Bootstrap superuser (created once by scripts/init.sh) -------------------
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
